#!/bin/bash
# アプリの EC2（Amazon Linux 2023）の初回起動。キーの値は出力しない（set -x を使わない）
set -euo pipefail

dnf install -y docker git make openssl
# Compose と Buildx のプラグイン。配布元のチェックサムで確かめてから入れる
dl="$(mktemp -d)"
compose_url="https://github.com/docker/compose/releases/download/${compose_version}"
buildx_url="https://github.com/docker/buildx/releases/download/${buildx_version}"
curl -fsSL -o "$dl/docker-compose-linux-x86_64" "$compose_url/docker-compose-linux-x86_64"
curl -fsSL -o "$dl/docker-compose-linux-x86_64.sha256" "$compose_url/docker-compose-linux-x86_64.sha256"
curl -fsSL -o "$dl/buildx-${buildx_version}.linux-amd64" "$buildx_url/buildx-${buildx_version}.linux-amd64"
curl -fsSL -o "$dl/buildx-checksums.txt" "$buildx_url/checksums.txt"
(cd "$dl" && sha256sum -c docker-compose-linux-x86_64.sha256 \
  && grep " \*buildx-${buildx_version}.linux-amd64$" buildx-checksums.txt | sha256sum -c -)
install -d /usr/local/lib/docker/cli-plugins
install -m 755 "$dl/docker-compose-linux-x86_64" /usr/local/lib/docker/cli-plugins/docker-compose
install -m 755 "$dl/buildx-${buildx_version}.linux-amd64" /usr/local/lib/docker/cli-plugins/docker-buildx
systemctl enable --now docker

# t3.small（メモリ 2GB）で Next.js をビルドするためのスワップ
if [ ! -f /swapfile ]; then
  fallocate -l 4G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

if [ ! -d /opt/tkb_2613 ]; then
  git clone --branch "${repo_ref}" --depth 1 "${repo_url}" /opt/tkb_2613
fi

# 起動ロジックはリポジトリで管理し、既存 EC2 も SSM 経由で同じものを配置する
install -m 700 /opt/tkb_2613/infra/tkb-app-start.sh /usr/local/bin/tkb-app-start

cat > /etc/systemd/system/tkb-app.service <<'UNIT'
[Unit]
Description=tkb_2613 web and api (docker compose)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/tkb-app-start
ExecStop=/usr/bin/docker compose --env-file /opt/tkb_2613/.env -f /opt/tkb_2613/infra/docker-compose.yml down
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
# .env を作るまでは失敗する。README の手順で .env を作ってから systemctl start tkb-app
systemctl enable tkb-app.service
