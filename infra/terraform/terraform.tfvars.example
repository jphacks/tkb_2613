# コピーして terraform.tfvars を作る（terraform.tfvars はコミットしない）
#   cp terraform.tfvars.example terraform.tfvars

alert_email = "<Budgets の通知を受けるメールアドレス>"

# GPU の空き容量に合わせて変更する（NAT とアプリは us-east-1a のまま）
# gpu_availability_zone = "us-east-1c"

# 確認用に小さい GPU で立てるとき
# gpu_instance_type = "g6.xlarge"
# vlm_model         = "QuantTrio/Qwen3.6-27B-AWQ"

# OCR を同居させるとき（11/11 に試す）
# ocr_image                   = "<PP-OCRv5 の HTTP サービスのイメージ>"
# vllm_gpu_memory_utilization = 0.80

# OAuth の公開前通し試験だけ、チームの現在のグローバル IPv4 /32 を入れる。
# 終わったら [] に戻して plan・apply し、state をリポジトリ外にバックアップする
# oauth_test_ipv4_cidrs = ["<チームの IPv4>/32"]
