# AWS のアプリの EC2 で使う .env の見本（docs/aws-migration.md の 3.3）。
# EC2 の上でリポジトリ直下に .env としてコピーし、<...> を埋める。.env はコミットしない。
#   cp infra/aws.env.example .env
# 起動：make up（docker compose --env-file .env -f infra/docker-compose.yml up --build -d）
#
# 値に $ が入る場合は '...' で囲む（compose が変数として展開しないように）。

# 実際の Bluesky とモデルにつなぐ
MOCK_MODE=0

# web を EC2 の外（CloudFront の VPC origin）から届くようにする。届く先はセキュリティグループで絞る。
# api（8001）は compose の中だけで使い、127.0.0.1 から変えない
WEB_BIND=0.0.0.0

# HTTPS（CloudFront）で公開するので、Cookie を HTTPS だけで送る
COOKIE_SECURE=1

# CloudFront の配信のオリジン。JSON の配列で書く（末尾の / は付けない）
CORS_ORIGINS=["https://<配信ID>.cloudfront.net"]

# VPC の中の GPU。VLM と OCR は同じインスタンス（docs/aws-migration.md の 3.5）
VLM_BASE_URL=http://<GPU のプライベート IP>:8000/v1
VLM_MODEL=qwen3.6-27b
OCR_BASE_URL=http://<GPU のプライベート IP>:8080
# 送り先の許可リスト。IP は完全一致なので、GPU のプライベート IP をそのまま書く
MODEL_ALLOWED_HOST_SUFFIXES=<GPU のプライベート IP>

# VLM のキーはここに書かない（空のまま）。起動スクリプト tkb-app-start が Secrets Manager から読み、
# メモリ上の /run/tkb_2613/secrets.env で compose に渡す（infra/terraform/README.md）
# （手順は infra/terraform/README.md に書く予定）
VLM_API_KEY=

BSKY_SERVICE=https://bsky.social
# api のセッションと web の OAuth のトークンの両方の有効時間（分）。アクセスでは延びない
SESSION_TTL_MINUTES=30
AUTH_MODE=oauth
# CORS_ORIGINS と同じ CloudFront オリジン。末尾 / は付けない
PUBLIC_URL=https://<配信ID>.cloudfront.net
OAUTH_WEB_ORIGIN=http://web:3000
# INTERNAL_AUTH_SECRET は .env に書かない。起動時に生成して /run から渡す
MAX_POSTS=30

# 乱用対策（docs/aws-migration.md の 5章）。値は仮。11/11 に診断時間を測って見直す
DIAGNOSE_DAILY_LIMIT=3
MAX_CONCURRENT_DIAGNOSES=2
DIAGNOSE_BUSY_RETRY_AFTER_SECONDS=30
DIAGNOSE_SLOT_TIMEOUT_SECONDS=900
MODEL_PROBE_TIMEOUT_SECONDS=3

# 公開時間帯の制限（docs/aws-migration.md の 5.2）。2026-11-10 に、本番でも制限しない（空）と決めた。
# 診断できるのは GPU が動いている間だけで、GPU が止まっていれば「準備中」（model_unavailable）になる。
# GPU を動かす時間帯は infra/terraform の public_windows（スケジュール）で決める
PUBLIC_WINDOWS=[]

# 閲覧リンクの機能をオフにする（公開中は診断結果を保存しない。docs/aws-migration.md の 14.1）。
# 画面にボタンを出さず、閲覧リンクの API は 404、保存先のファイルも作らない
SHARE_ENABLED=0

# Threads テスター限定。実ログインは Meta 側 URI 登録とログ確認後に明示的に有効化。
THREADS_MOCK_MODE=0
THREADS_ENABLED=0
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_PUBLIC_ORIGIN=https://<配信ID>.cloudfront.net
THREADS_CALLBACK_URL=https://<配信ID>.cloudfront.net/api/threads/callback
THREADS_QUERY_LOGS_REDACTED=0
THREADS_MAX_POSTS=30
THREADS_IMAGE_DIAGNOSIS=0
# 本文は Bluesky と同じ vLLM（上の VLM_*・MODEL_ALLOWED_HOST_SUFFIXES）で読む。
# 画像診断は明示的に有効化したときだけ画像1枚目を同じVLMで読む。
THREADS_TEXT_BACKEND=vlm

# X は合成投稿のデモだけ。実連携（OAuth・本人投稿の原文表示）は X の用途承認と費用承認が届くまでオフ。
# 承認後の手順は docs/x-poc.md。ここでは承認フラグを 1 にしない。
X_MOCK_MODE=1
# 合成デモでも要る。未設定だと http://localhost:3000 になり、/api/x の POST がすべて 403 になる
X_PUBLIC_ORIGIN=https://<配信ID>.cloudfront.net
X_CALLBACK_URL=https://<配信ID>.cloudfront.net/api/x/callback
X_USE_CASE_APPROVED=0
X_PAID_READS_APPROVED=0
X_QUERY_LOGS_REDACTED=0
X_CLIENT_ID=
# 本番の Secret はここに書かない。Secrets Manager の tkb_2613/x-client-secret から起動時に渡す
X_CLIENT_SECRET=
X_MAX_POSTS=5
X_DAILY_RESOURCE_LIMIT=12
# 合成投稿デモだけに使う。実アカウントは常に原文表示のみ
X_INFO_VIEW=aggregate
