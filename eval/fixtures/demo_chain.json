  "posts": [
    {
      "post_id": "at://did:plc:demox1000000000000000000/app.bsky.feed.post/x1001",
      "text": "根津駅、朝のホームが思ったより混んでる。",
      "created_at": "2026-10-25T12:00:00+09:00",
      "images": []
    },
    {
      "post_id": "at://did:plc:demox1000000000000000000/app.bsky.feed.post/x1002",
      "text": "帰りに根津駅で降りて、駅前のパン屋に寄るのが最近の楽しみ。",
      "created_at": "2026-10-25T12:03:00+09:00",
      "images": []
    },
    {
      "post_id": "at://did:plc:demox1000000000000000000/app.bsky.feed.post/x1003",
      "text": "筑波大学の研究室、今日は進捗ゼロ。",
      "created_at": "2026-10-25T12:06:00+09:00",
      "images": []
    },
    {
      "post_id": "at://did:plc:demox1000000000000000000/app.bsky.feed.post/x1004",
      "text": "家から大学まで毎日通ってると、往復だけでだいぶ疲れる。",
      "created_at": "2026-10-25T12:09:00+09:00",
      "images": []
    },
    {
      "post_id": "at://did:plc:demox1000000000000000000/app.bsky.feed.post/x2001",
      "text": "4月14日は誕生日だった。ケーキを1人で食べた。",
      "created_at": "2026-10-25T12:12:00+09:00",
      "images": []
    },
    {
      "post_id": "at://did:plc:demox1000000000000000000/app.bsky.feed.post/x2002",
      "text": "21歳、いまだに自炊がうまくならない。",
      "created_at": "2026-10-25T12:15:00+09:00",
      "images": []
    },
    {
      "post_id": "at://did:plc:demox1000000000000000000/app.bsky.feed.post/x2003",
      "text": "ベーカリーねこぜの塩パン、ここ毎週来てる。",
      "created_at": "2026-10-25T12:18:00+09:00",
      "images": []
    },
    {
      "post_id": "at://did:plc:demox1000000000000000000/app.bsky.feed.post/x2004",
      "text": "根津駅から歩いてすぐのベーカリーねこぜ、新作のあんバターがおいしい。",
      "created_at": "2026-10-25T12:21:00+09:00",
      "images": []
    },
    {
      "post_id": "at://did:plc:demox1000000000000000000/app.bsky.feed.post/x2005",
      "text": "カフェ コモレビのシフト終わり。まかないのオムライスが最高。",
      "created_at": "2026-10-25T12:24:00+09:00",
      "images": []
    },
    {
      "post_id": "at://did:plc:demox1000000000000000000/app.bsky.feed.post/x2006",
      "text": "来週から3泊で実家に帰省する。猫の世話は友達に頼んだ。",
      "created_at": "2026-10-25T12:27:00+09:00",
      "images": []
    }
  ],
