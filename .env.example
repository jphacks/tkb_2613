# コピーして .env を作る（.env はコミットしない）
#   cp .env.example .env

# 1 のときは固定の手がかりを返し、外部に一切接続しない（既定）
MOCK_MODE=1

# 画像を読む言語モデル（vLLM, OpenAI 互換 API）。送り先はチームのサーバーだけ
VLM_BASE_URL=http://localhost:8000/v1
VLM_API_KEY=
VLM_MODEL=

# 本文だけ Ollama に切り替える場合に ollama を指定。既定の vlm は従来動作。
TEXT_BACKEND=vlm
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct

# OCR（PP-OCRv5 の HTTP サービス）
OCR_BASE_URL=http://localhost:8080

# 写真・本文（VLM と OCR）の送り先の許可リスト（カンマ区切り）。ここに書いたホストにだけ送れる。
# - ホスト名はそのホストとサブドメインを許可する。RunPod は Pod ごとのホスト名まで書く
#   （例 MODEL_ALLOWED_HOST_SUFFIXES=<POD_ID>-8000.proxy.runpod.net,<POD_ID>-8080.proxy.runpod.net）。
#   proxy.runpod.net だけだと、RunPod のほかの利用者の Pod にも送れてしまう
# - IP は完全一致だけを許可する。AWS の VPC 内の GPU なら MODEL_ALLOWED_HOST_SUFFIXES=10.0.2.15 のように書く
# 空のときは localhost（127.0.0.1、::1）にだけ送れる。リモートモデルを使う場合は必ず設定する。
# 169.254.*（メタデータ）などの特別用途の IP と、既知の第三者 AI サービスには、ここに書いても送れない。
MODEL_ALLOWED_HOST_SUFFIXES=
# 公開Web検索（Brave）。診断ごとの同意がない限り使用しない。最大90日の検索語保持と支払情報要件を同意UIに表示する。
BRAVE_SEARCH_API_KEY=

# Bluesky のログイン先と、ログインのセッションを持つ時間（分）。api のセッションと web の OAuth のトークンの両方に効く
BSKY_SERVICE=https://bsky.social
SESSION_TTL_MINUTES=30
# ローカルは既存方式。OAuth の試験は oauth と PUBLIC_URL を設定する
AUTH_MODE=app_password
PUBLIC_URL=http://127.0.0.1:3000
# OAuth 時、Next.js から FastAPI へ接続する内部 URL
API_INTERNAL_ORIGIN=http://127.0.0.1:8001
OAUTH_WEB_ORIGIN=http://127.0.0.1:3000
# ローカルで OAuth を試す場合だけ、API と web に同じランダム値を設定する
INTERNAL_AUTH_SECRET=
# 診断で読む自分の投稿の件数（新しい順、1〜100）
MAX_POSTS=30
# HTTPS で公開するときは 1 にする（Cookie を HTTPS だけで送る）
COOKIE_SECURE=0
# 画面（api の CORS）で許可するオリジン。JSON の配列。HTTPS で公開するときは公開する URL にする
# 消す・ログアウト・閲覧リンクの作成と取り消しは、Origin がここにある画面からの要求だけを受け付ける。
# ブラウザで開くオリジンを入れる（OAuth の試験で http://127.0.0.1:3000 を開くなら、それも足す）
CORS_ORIGINS=["http://localhost:3000"]

# make up で web を公開するアドレス。手元は 127.0.0.1 のまま。AWS のアプリの EC2 では 0.0.0.0
# （AWS で使う値の見本は infra/aws.env.example）
WEB_BIND=127.0.0.1

# 画面（Next.js）が /api を中継する先の api。ビルド時に読まれる（web/next.config.ts の rewrites）
# ローカルは既定の http://localhost:8001 のままでよい。Vercel では、公開した api の URL を Vercel の環境変数に入れる
API_ORIGIN=http://localhost:8001

# 本人が作った閲覧リンクの結果を保持する場所と期限（分）。公開環境では永続ボリューム上のパスにする
SHARE_DB_PATH=data/private/shared_results.sqlite3
SHARE_TTL_MINUTES=120
# 閲覧リンクの機能。0 にすると画面にボタンを出さず、API も 404 にし、保存先も作らない（公開中の本番は 0）
SHARE_ENABLED=1

# 乱用対策（docs/aws-migration.md の 5章）。0 は「制限しない」。手元の開発では 0 のままでよい
# （.env に書かなければ api の既定値：1日3回、同時2）
# 1アカウント1日（日本時間）の診断回数。超えたら 429
DIAGNOSE_DAILY_LIMIT=0
# 同時に診断できる数。空きがなければ待たずに 503（混雑しています）
MAX_CONCURRENT_DIAGNOSES=0
# 混雑で断るときに Retry-After で伝える秒数
DIAGNOSE_BUSY_RETRY_AFTER_SECONDS=30
# 診断の枠を返し損ねても、この秒数たてば空いたものとして扱う
DIAGNOSE_SLOT_TIMEOUT_SECONDS=900
# 公開する時間帯（JSON の配列。時刻は時差つき）。時間外は 503 と次の公開の開始時刻を返す。空なら制限しない
#   例 PUBLIC_WINDOWS=[{"start":"2026-11-16T20:00:00+09:00","end":"2026-11-16T22:00:00+09:00"}]
PUBLIC_WINDOWS=[]
# 診断を始める前に、モデルのサーバーが応答するかを確かめる待ち時間（秒）。応答しなければ 503（準備中）
MODEL_PROBE_TIMEOUT_SECONDS=3

# X 専用の架空投稿デモ。既定は 1。実 X API は用途承認と費用承認を確認するまで無効。
X_MOCK_MODE=1
# X Developer Console の OAuth 2.0 Web App資格情報。SecretはAPIサーバーだけに設定する。
X_CLIENT_ID=
X_CLIENT_SECRET=
# X Developer Console に完全一致で登録するコールバック URL と画面の公開オリジン。
X_CALLBACK_URL=http://localhost:3000/api/x/callback
X_PUBLIC_ORIGIN=http://localhost:3000
# 下の3つが1、Web App資格情報が設定済み、X_MOCK_MODE=0でなければ実読み取りを開始しない。
# X に自己診断用途の明示的な許可を得て、チームで料金を承認した場合だけ設定する。
X_USE_CASE_APPROVED=0
X_PAID_READS_APPROVED=0
# Next.js・リバースプロキシのOAuthコールバックURLのクエリをログに残さない設定を確認したときだけ1。
X_QUERY_LOGS_REDACTED=0
# 1回の本人チェックで読む最大投稿数。上限30。仮除外はメモリ内データで再集計し再課金しない。
X_MAX_POSTS=30
# X API で1日（UTC）に読んでよいリソース数。本人確認1件＋投稿の取得件数を、呼ぶ前に最大数で数える。
# 超えたら X を呼ばずに断る。カウンタはメモリなので再起動で戻る。Console の支出上限も必ず設定する。
X_DAILY_RESOURCE_LIMIT=40

# Threads は読み取り専用。実認証は明示的に有効化するまで無効。
THREADS_MOCK_MODE=1
THREADS_ENABLED=0
THREADS_APP_ID=
THREADS_APP_SECRET=
# Meta に完全一致で登録する HTTPS URL。秘密情報はサーバーだけに設定。
THREADS_PUBLIC_ORIGIN=https://example.com
THREADS_CALLBACK_URL=https://example.com/api/threads/callback
# Next.js・CloudFront・プロキシのコールバッククエリを記録しないことを確認後のみ 1。
THREADS_QUERY_LOGS_REDACTED=0
THREADS_MAX_POSTS=30
THREADS_GPU_DEMO_ENABLED=0
